# Configuration Hadoop injectée dans les conteneurs (image apache/hadoop) :
# une variable FICHIER_propriété=valeur devient une <property> du fichier XML correspondant.
# C'est l'équivalent des fichiers conf/core-site.xml et conf/hdfs-site.xml (voir à côté).

# core-site.xml : OÙ est le système de fichiers ?
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_fs.default.name=hdfs://namenode:8020

# hdfs-site.xml : COMMENT stocker les blocs ?
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.replication=1
HDFS-SITE.XML_dfs.permissions.enabled=false
